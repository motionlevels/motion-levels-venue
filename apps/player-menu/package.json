{
  "name": "@motion-levels/player-menu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "electron:dev": "PLAYER_MENU_URL=http://127.0.0.1:4103 electron electron/main.cjs",
    "electron": "npm run build && electron electron/main.cjs",
    "pack:mac": "npm run build && electron-builder --mac dir",
    "dist:mac": "npm run build && electron-builder --mac dmg"
  },
  "build": {
    "appId": "dev.obis.motionlevels.player-menu",
    "productName": "Motion Levels Player Menu",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "identity": null,
      "target": [
        "dir"
      ]
    },
    "dmg": {
      "sign": false
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@motion-levels/core": "file:../../packages/core",
    "@motion-levels/design-tokens": "file:../../packages/design-tokens",
    "@motion-levels/floor-view": "file:../../packages/floor-view",
    "posthog-js": "^1.390.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "overrides": {
    "dompurify": "^3.4.11"
  }
}
