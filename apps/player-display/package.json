{
  "name": "@motion-levels/player-display",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "electron:dev": "PLAYER_DISPLAY_URL=http://127.0.0.1:4104 electron electron/main.cjs",
    "electron": "npm run build && electron electron/main.cjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@motion-levels/core": "file:../../packages/core",
    "@motion-levels/design-tokens": "file:../../packages/design-tokens",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
