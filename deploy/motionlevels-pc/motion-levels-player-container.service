[Unit]
Description=Motion Levels Wayland player container
Requires=motion-levels-venue-containers.service motion-levels-display-wayland.service
After=motion-levels-venue-containers.service motion-levels-display-wayland.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/
ExecStart=/bin/sh -ec 'compose_file=$$(sed -n "s/^VENUE_COMPOSE_FILE=//p" /etc/motion-levels/venue/current.env); exec /usr/bin/docker compose --env-file /etc/motion-levels/venue/current.env -f "$$compose_file" --profile wayland-display up -d --no-build --wait --wait-timeout 120 player'
ExecStop=/bin/sh -ec 'compose_file=$$(sed -n "s/^VENUE_COMPOSE_FILE=//p" /etc/motion-levels/venue/current.env); test -z "$$compose_file" || exec /usr/bin/docker compose --env-file /etc/motion-levels/venue/current.env -f "$$compose_file" --profile wayland-display stop --timeout 30 player'
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=graphical.target
