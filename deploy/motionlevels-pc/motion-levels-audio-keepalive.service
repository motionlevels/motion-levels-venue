[Unit]
Description=Motion Levels persistent HDMI mixer owner
After=sound.target
Before=motion-levels-audio.socket

[Service]
Type=exec
User=motionlevels-audio
Group=motionlevels-audio
SupplementaryGroups=audio
Environment=HOME=/tmp
# Keep dmix and the SOF HDMI PCM open across individual music and effect
# streams. Rapid close/reopen cycles can leave this appliance's HDMI DMA
# pointer stalled until every client is terminated.
ExecStart=/usr/bin/aplay -q -D default -t raw -f S16_LE -c 2 -r 48000 /dev/zero
Restart=always
RestartSec=1
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=no
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=/dev/snd/controlC0 rw
DeviceAllow=/dev/snd/pcmC0D5p rw
DeviceAllow=/dev/snd/timer rw
TasksMax=16
MemoryMax=64M
UMask=0077

[Install]
WantedBy=multi-user.target
