[Unit]
Description=Motion Levels minimal Weston display boundary
After=systemd-user-sessions.service network-online.target seatd.service
Wants=network-online.target
Requires=seatd.service
Before=motion-levels-player-container.service
Conflicts=getty@tty7.service display-manager.service motion-levels-kiosk.service

[Service]
Type=simple
User=motionlevels-display
Group=motionlevels-display
SupplementaryGroups=video render
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
UtmpIdentifier=tty7
Environment=XDG_RUNTIME_DIR=/run/motion-levels-display
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_SEAT=seat0
Environment=LIBSEAT_BACKEND=seatd
RuntimeDirectory=motion-levels-display
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
ExecStartPre=+/usr/bin/chvt 7
ExecStart=/usr/local/bin/motion-levels-display-agent
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
DevicePolicy=closed
DeviceAllow=/dev/dri/card0 rw
DeviceAllow=/dev/dri/renderD128 rw
DeviceAllow=/dev/tty0 rw
DeviceAllow=/dev/tty7 rw
InaccessiblePaths=/dev/input
ReadWritePaths=/run/motion-levels-display
TasksMax=256
MemoryMax=512M

[Install]
WantedBy=graphical.target
