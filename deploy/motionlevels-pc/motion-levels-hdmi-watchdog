#!/usr/bin/env bash
# Keeps the HDMI TV output usable after hotplug, power-cycle, or EDID glitches.
set -euo pipefail

ENV_FILE=/etc/motion-levels/motion-levels.env

env_file_value() {
  local key="$1"
  local fallback="${2:-}"
  local value=""

  if [ -f "${ENV_FILE}" ]; then
    value="$(awk -v key="${key}" '
      /^[[:space:]]*#/ { next }
      /^[[:space:]]*$/ { next }
      index($0, key "=") == 1 {
        sub(/^[^=]*=/, "")
        print
        exit
      }
    ' "${ENV_FILE}")"
  fi

  value="${value%$'\r'}"
  if [ "${#value}" -ge 2 ]; then
    local first="${value:0:1}"
    local last="${value: -1}"
    if { [ "${first}" = '"' ] && [ "${last}" = '"' ]; } || { [ "${first}" = "'" ] && [ "${last}" = "'" ]; }; then
      value="${value:1:${#value}-2}"
    fi
  fi

  if [ -n "${value}" ]; then
    printf '%s' "${value}"
  else
    printf '%s' "${fallback}"
  fi
}

truthy_env() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

log() {
  printf 'motion-levels-hdmi-watchdog: %s\n' "$*"
}

validated_integer() {
  local value="$1"
  local fallback="$2"
  local minimum="$3"
  local maximum="$4"
  local label="$5"

  if [[ "${value}" =~ ^[0-9]+$ && ${#value} -le 9 ]] \
    && (( 10#${value} >= minimum && 10#${value} <= maximum )); then
    printf '%s' "$((10#${value}))"
    return 0
  fi

  log "invalid ${label} '${value}'; using ${fallback}" >&2
  printf '%s' "${fallback}"
}

MOTION_LEVELS_XRANDR_MODE="$(env_file_value MOTION_LEVELS_XRANDR_MODE)"
MOTION_LEVELS_XRANDR_RATE="$(env_file_value MOTION_LEVELS_XRANDR_RATE 60)"
MOTION_LEVELS_XRANDR_OUTPUT="$(env_file_value MOTION_LEVELS_XRANDR_OUTPUT)"
MOTION_LEVELS_PLAYER_URL="$(env_file_value MOTION_LEVELS_PLAYER_URL http://127.0.0.1/display/)"
MOTION_LEVELS_FORCE_ALSA_OUTPUT="$(env_file_value MOTION_LEVELS_FORCE_ALSA_OUTPUT 0)"
POLL_SECONDS="$(validated_integer "$(env_file_value MOTION_LEVELS_HDMI_WATCHDOG_INTERVAL 10)" 10 1 3600 MOTION_LEVELS_HDMI_WATCHDOG_INTERVAL)"
RESTART_COOLDOWN_SECONDS="$(validated_integer "$(env_file_value MOTION_LEVELS_HDMI_WATCHDOG_RESTART_COOLDOWN 45)" 45 0 86400 MOTION_LEVELS_HDMI_WATCHDOG_RESTART_COOLDOWN)"
FAILURES_BEFORE_RESTART="$(validated_integer "$(env_file_value MOTION_LEVELS_HDMI_WATCHDOG_FAILURES 3)" 3 1 100 MOTION_LEVELS_HDMI_WATCHDOG_FAILURES)"
HDMI_METRICS_FILE="${MOTION_LEVELS_HDMI_METRICS_FILE:-$(env_file_value MOTION_LEVELS_HDMI_METRICS_FILE)}"
HDMI_METRICS_CONNECTOR="${MOTION_LEVELS_HDMI_METRICS_CONNECTOR:-$(env_file_value MOTION_LEVELS_HDMI_METRICS_CONNECTOR "${MOTION_LEVELS_XRANDR_OUTPUT:-unknown}")}"
HDMI_METRICS_CONFIRMATIONS="$(validated_integer "${MOTION_LEVELS_HDMI_METRICS_CONFIRMATIONS:-$(env_file_value MOTION_LEVELS_HDMI_METRICS_CONFIRMATIONS 3)}" 3 1 60 MOTION_LEVELS_HDMI_METRICS_CONFIRMATIONS)"
MOTION_LEVELS_BOOT_ID_FILE="${MOTION_LEVELS_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}"

last_restart=0
failure_count=0
display_state_initialized=0
last_display_output=""
last_display_geometry=""
alsa_device_state_initialized=0
last_live_hdmi_alsa_device=""
restart_pending_reason=""
hdmi_metrics_loaded=0
hdmi_metrics_baselined=0
hdmi_metrics_connected=0
hdmi_metrics_last_transition_timestamp=0
hdmi_metrics_candidate_connected=""
hdmi_metrics_candidate_count=0
hdmi_metrics_boot_id=""

hdmi_metrics_state_file() {
  if [[ "${HDMI_METRICS_FILE}" == *.prom ]]; then
    printf '%s.state' "${HDMI_METRICS_FILE%.prom}"
  else
    printf '%s.state' "${HDMI_METRICS_FILE}"
  fi
}

current_boot_id() {
  local boot_id=""

  if [ -r "${MOTION_LEVELS_BOOT_ID_FILE}" ]; then
    IFS= read -r boot_id <"${MOTION_LEVELS_BOOT_ID_FILE}" || true
  fi
  if [[ "${boot_id}" =~ ^[0-9A-Fa-f-]+$ ]]; then
    printf '%s' "${boot_id}"
  fi
}

load_hdmi_metrics_state() {
  local state_file stored_boot_id="" stored_connected="" stored_timestamp=""
  local key value

  [ "${hdmi_metrics_loaded}" -eq 0 ] || return 0
  hdmi_metrics_loaded=1
  [ -n "${HDMI_METRICS_FILE}" ] || return 0

  hdmi_metrics_boot_id="$(current_boot_id)"
  state_file="$(hdmi_metrics_state_file)"
  if [ -r "${state_file}" ]; then
    while IFS='=' read -r key value; do
      case "${key}" in
        boot_id)
          if [[ "${value}" =~ ^[0-9A-Fa-f-]+$ ]]; then
            stored_boot_id="${value}"
          fi
          ;;
        connected)
          if [ "${value}" = 0 ] || [ "${value}" = 1 ]; then
            stored_connected="${value}"
          fi
          ;;
        last_transition_timestamp)
          if [[ "${value}" =~ ^[0-9]+$ ]]; then
            stored_timestamp="${value}"
          fi
          ;;
      esac
    done <"${state_file}"
  fi

  if [ -n "${stored_connected}" ]; then
    hdmi_metrics_connected="${stored_connected}"
  fi
  if [ -n "${stored_timestamp}" ]; then
    hdmi_metrics_last_transition_timestamp="${stored_timestamp}"
  fi
  if [ -n "${hdmi_metrics_boot_id}" ] \
    && [ "${stored_boot_id}" = "${hdmi_metrics_boot_id}" ] \
    && [ -n "${stored_connected}" ]; then
    hdmi_metrics_baselined=1
  fi
}

write_hdmi_metrics_state() {
  local state_file temp_file

  [ -n "${HDMI_METRICS_FILE}" ] || return 0
  state_file="$(hdmi_metrics_state_file)"
  [ -d "${state_file%/*}" ] || return 1
  temp_file="$(mktemp "${state_file}.tmp.XXXXXX")" || return 1
  if ! {
    printf 'boot_id=%s\n' "${hdmi_metrics_boot_id}"
    printf 'connected=%s\n' "${hdmi_metrics_connected}"
    printf 'last_transition_timestamp=%s\n' "${hdmi_metrics_last_transition_timestamp}"
  } >"${temp_file}"; then
    rm -f -- "${temp_file}"
    return 1
  fi
  chmod 0644 "${temp_file}" || {
    rm -f -- "${temp_file}"
    return 1
  }
  mv -f -- "${temp_file}" "${state_file}"
}

prometheus_escape_label() {
  local value="$1"

  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  printf '%s' "${value}"
}

write_hdmi_metrics() {
  local detector_up="$1"
  local temp_file connector

  [ -n "${HDMI_METRICS_FILE}" ] || return 0
  [ -d "${HDMI_METRICS_FILE%/*}" ] || return 1
  connector="$(prometheus_escape_label "${HDMI_METRICS_CONNECTOR:-unknown}")"
  temp_file="$(mktemp "${HDMI_METRICS_FILE}.tmp.XXXXXX")" || return 1
  if ! {
    printf '# HELP motionlevels_hdmi_connected Whether the debounced HDMI connector state is connected.\n'
    printf '# TYPE motionlevels_hdmi_connected gauge\n'
    printf 'motionlevels_hdmi_connected{connector="%s"} %s\n' "${connector}" "${hdmi_metrics_connected}"
    printf '# HELP motionlevels_hdmi_detector_up Whether the HDMI detector returned a usable X display observation.\n'
    printf '# TYPE motionlevels_hdmi_detector_up gauge\n'
    printf 'motionlevels_hdmi_detector_up %s\n' "${detector_up}"
    printf '# HELP motionlevels_hdmi_last_transition_timestamp_seconds Unix timestamp of the most recent debounced HDMI connect or disconnect transition.\n'
    printf '# TYPE motionlevels_hdmi_last_transition_timestamp_seconds gauge\n'
    printf 'motionlevels_hdmi_last_transition_timestamp_seconds{connector="%s"} %s\n' "${connector}" "${hdmi_metrics_last_transition_timestamp}"
  } >"${temp_file}"; then
    rm -f -- "${temp_file}"
    return 1
  fi
  chmod 0644 "${temp_file}" || {
    rm -f -- "${temp_file}"
    return 1
  }
  mv -f -- "${temp_file}" "${HDMI_METRICS_FILE}"
}

record_hdmi_metrics_observation() {
  local detector_up="$1"
  local observed_connected="$2"

  [ -n "${HDMI_METRICS_FILE}" ] || return 0
  load_hdmi_metrics_state

  if [ "${detector_up}" -eq 0 ]; then
    hdmi_metrics_candidate_connected=""
    hdmi_metrics_candidate_count=0
  elif [ "${hdmi_metrics_baselined}" -eq 0 ]; then
    # A new VM boot establishes a baseline without replaying a synthetic
    # disconnect caused by the previous shutdown.
    hdmi_metrics_connected="${observed_connected}"
    hdmi_metrics_baselined=1
    hdmi_metrics_candidate_connected=""
    hdmi_metrics_candidate_count=0
    write_hdmi_metrics_state || log "could not persist HDMI metrics baseline" >&2
  elif [ "${observed_connected}" = "${hdmi_metrics_connected}" ]; then
    hdmi_metrics_candidate_connected=""
    hdmi_metrics_candidate_count=0
  else
    if [ "${observed_connected}" = "${hdmi_metrics_candidate_connected}" ]; then
      hdmi_metrics_candidate_count=$((hdmi_metrics_candidate_count + 1))
    else
      hdmi_metrics_candidate_connected="${observed_connected}"
      hdmi_metrics_candidate_count=1
    fi

    if [ "${hdmi_metrics_candidate_count}" -ge "${HDMI_METRICS_CONFIRMATIONS}" ]; then
      hdmi_metrics_connected="${observed_connected}"
      hdmi_metrics_last_transition_timestamp="$(date +%s)"
      hdmi_metrics_candidate_connected=""
      hdmi_metrics_candidate_count=0
      write_hdmi_metrics_state || log "could not persist HDMI metrics transition" >&2
    fi
  fi

  write_hdmi_metrics "${detector_up}" || log "could not publish HDMI metrics" >&2
}

query_display() {
  /usr/bin/xrandr --query --props 2>/dev/null || true
}

display_output_from_query() {
  local query="$1"
  local preferred_output="${2:-}"
  awk -v preferred="${preferred_output}" '
    $2 == "connected" && $1 ~ /^HDMI([.-]|$)/ {
      if (first_hdmi == "") {
        first_hdmi = $1
      }
      active = 0
      for (field = 3; field <= NF; field += 1) {
        if ($field ~ /^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+/) {
          active = 1
          break
        }
      }
      if ($1 == preferred) {
        preferred_hdmi = $1
      }
      if (active && first_active_hdmi == "") {
        first_active_hdmi = $1
      }
    }
    END {
      if (preferred_hdmi != "") {
        print preferred_hdmi
      } else if (first_active_hdmi != "") {
        print first_active_hdmi
      } else if (first_hdmi != "") {
        print first_hdmi
      }
    }
  ' <<<"${query}"
}

active_geometry_for_output() {
  local query="$1"
  local output="$2"
  awk -v output="${output}" '
    $1 == output && $2 == "connected" {
      for (field = 3; field <= NF; field += 1) {
        if ($field ~ /^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+/) {
          print $field
          exit
        }
      }
    }
  ' <<<"${query}"
}

display_geometry_is_usable() {
  local geometry="$1"
  local size="${geometry%%[+-]*}"
  local expected_size="${MOTION_LEVELS_XRANDR_MODE:-}"

  [ -n "${geometry}" ] \
    && [ "${size}" != "1024x768" ] \
    && [[ "${geometry}" == *+0+0 ]] \
    && { [ -z "${expected_size}" ] || [ "${size}" = "${expected_size}" ]; }
}

eld_is_live_hdmi() {
  local eld_file="$1"
  awk '
    $1 == "monitor_present" && $2 == "1" { monitor_present = 1 }
    $1 == "eld_valid" && $2 == "1" { eld_valid = 1 }
    $1 == "connection_type" && $2 == "HDMI" { hdmi = 1 }
    END { exit !(monitor_present && eld_valid && hdmi) }
  ' "${eld_file}"
}

alsa_pcm_device_for_eld() {
  local card_dir="$1"
  local eld_index="$2"
  local info_file device="" matched_device=""

  for info_file in "${card_dir}"/pcm*p/info; do
    [ -r "${info_file}" ] || continue
    if ! awk -v eld_index="${eld_index}" '
      $1 == "stream:" && $2 == "PLAYBACK" { playback = 1 }
      $1 == "id:" && $2 == "HDMI" && $3 == eld_index { matching_id = 1 }
      END { exit !(playback && matching_id) }
    ' "${info_file}"; then
      continue
    fi

    device="$(awk '$1 == "device:" && $2 ~ /^[0-9]+$/ { print $2; exit }' "${info_file}")"
    [ -n "${device}" ] || continue
    [ -z "${matched_device}" ] || return 1
    matched_device="${device}"
  done

  [ -n "${matched_device}" ] || return 1
  printf '%s' "${matched_device}"
}

hdmi_eld_index_for_output() {
  local output="$1"

  if [[ "${output}" =~ ^HDMI(-A)?-([1-9][0-9]*)$ ]]; then
    printf '%s' "$((10#${BASH_REMATCH[2]} - 1))"
    return 0
  fi
  return 1
}

resolve_live_hdmi_alsa_device() {
  local output="$1"
  local asound_root="${MOTION_LEVELS_PROC_ASOUND_ROOT:-/proc/asound}"
  local eld_file eld_index card_dir card_basename card_number pcm_device
  local candidate="" resolved_device=""

  eld_index="$(hdmi_eld_index_for_output "${output}")" || return 1
  for eld_file in "${asound_root}"/card*/eld#*."${eld_index}"; do
    [ -r "${eld_file}" ] || continue
    eld_is_live_hdmi "${eld_file}" || continue

    card_dir="${eld_file%/*}"
    card_basename="${card_dir##*/}"
    if [[ ! "${card_basename}" =~ ^card([0-9]+)$ ]]; then
      continue
    fi
    card_number="${BASH_REMATCH[1]}"
    pcm_device="$(alsa_pcm_device_for_eld "${card_dir}" "${eld_index}")" || continue
    candidate="plughw:${card_number},${pcm_device}"

    [ -z "${resolved_device}" ] || return 1
    resolved_device="${candidate}"
  done

  [ -n "${resolved_device}" ] || return 1
  printf '%s' "${resolved_device}"
}

alsa_card_from_device() {
  local device="$1"

  if [[ "${device}" =~ ^plughw:([0-9]+),[0-9]+$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi
  return 1
}

audio_state_for_output() {
  local query="$1"
  local output="$2"
  awk -v output="${output}" '
    $1 == output && $2 == "connected" { in_output = 1; next }
    in_output && /^[^[:space:]]/ { in_output = 0 }
    in_output && $1 == "audio:" { print $2; exit }
  ' <<<"${query}"
}

enable_hdmi_audio_output() {
  local output="$1"

  if [ -n "${output}" ]; then
    /usr/bin/xrandr --output "${output}" --set audio on 2>/dev/null || true
  fi
}

configure_hdmi_alsa_controls() {
  local alsa_device="$1"
  local control alsa_card=""

  alsa_card="$(alsa_card_from_device "${alsa_device}")" || true
  if [ -n "${alsa_card}" ] && command -v /usr/bin/amixer >/dev/null 2>&1; then
    for control in IEC958 "IEC958,0" "IEC958,1" "IEC958,2"; do
      /usr/bin/amixer -q -c "${alsa_card}" sset "${control}" unmute 2>/dev/null || true
      /usr/bin/amixer -q -c "${alsa_card}" sset "${control}" on 2>/dev/null || true
    done
  fi
}

configure_display() {
  local output="$1"
  local mode="${MOTION_LEVELS_XRANDR_MODE:-}"
  local rate="${MOTION_LEVELS_XRANDR_RATE:-60}"

  /usr/bin/xrandr --output "${output}" --auto --primary --pos 0x0 2>/dev/null || true
  if [ -n "${mode}" ]; then
    /usr/bin/xrandr --output "${output}" --mode "${mode}" --rate "${rate}" --primary --pos 0x0 2>/dev/null || true
  fi
}

chromium_running() {
  # Chromium re-execs its real binary after the compatibility launcher. On
  # NixOS that leaves a /nix/store path in the process list, while Debian uses
  # /usr/lib/chromium. Match the exact kiosk argument instead of either
  # distribution-specific executable path; helper processes do not carry it.
  pgrep -af chromium 2>/dev/null \
    | grep -F -- "--app=${MOTION_LEVELS_PLAYER_URL}" \
    >/dev/null
}

fetch_display_client() {
  /usr/bin/curl --fail --silent --show-error --max-time 3 \
    http://127.0.0.1:4102/api/display-client
}

display_client_healthy() {
  local payload
  payload="$(fetch_display_client)" || return 1
  printf '%s' "${payload}" | /usr/bin/python3 -c '
import json
import sys

try:
    status = json.load(sys.stdin)
except (json.JSONDecodeError, OSError, TypeError, ValueError):
    raise SystemExit(1)
raise SystemExit(
    0
    if isinstance(status, dict)
    and status.get("fresh") is True
    and status.get("healthy") is True
    else 1
)
'
}

restart_kiosk() {
  local reason="$1"
  local now
  now="$(date +%s)"

  if [ $((now - last_restart)) -lt "${RESTART_COOLDOWN_SECONDS}" ]; then
    log "${reason}; restart cooling down"
    return 1
  fi

  log "${reason}; restarting motion-levels-kiosk.service"
  last_restart="${now}"
  if systemctl restart motion-levels-kiosk.service; then
    failure_count=0
    return 0
  else
    log "${reason}; failed to restart motion-levels-kiosk.service"
    return 1
  fi
}

queue_kiosk_restart() {
  restart_pending_reason="$1"
}

attempt_pending_kiosk_restart() {
  local reason

  if [ -z "${restart_pending_reason}" ]; then
    return 0
  fi

  reason="${restart_pending_reason}"
  if restart_kiosk "${reason}"; then
    restart_pending_reason=""
  fi
  return 0
}

restart_kiosk_if_needed() {
  local reason="$1"

  failure_count=$((failure_count + 1))
  if [ "${failure_count}" -lt "${FAILURES_BEFORE_RESTART}" ]; then
    log "${reason}; failure ${failure_count}/${FAILURES_BEFORE_RESTART}"
    return 0
  fi

  # This condition is re-evaluated on every poll. Do not leave a sticky
  # restart behind during cooldown: the renderer may recover before the next
  # check. Persistent pending restarts are reserved for one-shot display
  # topology changes, which cannot be rediscovered after the state snapshot
  # advances.
  restart_kiosk "${reason}" || true
}

watchdog_check() {
  local xrandr_output output geometry original_geometry audio_state geometry_repaired
  local previous_output previous_geometry state_was_initialized state_changed
  local previous_alsa_device alsa_state_was_initialized live_alsa_device alsa_device_changed
  local hdmi_audio_repaired

  previous_output="${last_display_output}"
  previous_geometry="${last_display_geometry}"
  state_was_initialized="${display_state_initialized}"
  previous_alsa_device="${last_live_hdmi_alsa_device}"
  alsa_state_was_initialized="${alsa_device_state_initialized}"

  xrandr_output="$(query_display)"
  output="$(display_output_from_query "${xrandr_output}" "${MOTION_LEVELS_XRANDR_OUTPUT}")"

  if [ -z "${xrandr_output}" ]; then
    record_hdmi_metrics_observation 0 0
    restart_kiosk_if_needed "X display is unavailable"
    return 0
  fi

  if [ -z "${output}" ]; then
    record_hdmi_metrics_observation 1 0
    failure_count=0
    display_state_initialized=1
    last_display_output=""
    last_display_geometry=""
    alsa_device_state_initialized=1
    last_live_hdmi_alsa_device=""
    log "no HDMI output connected"
    return 0
  fi

  record_hdmi_metrics_observation 1 1

  geometry="$(active_geometry_for_output "${xrandr_output}" "${output}")"
  original_geometry="${geometry}"
  audio_state="$(audio_state_for_output "${xrandr_output}" "${output}")"
  geometry_repaired=0
  hdmi_audio_repaired=0

  if ! display_geometry_is_usable "${geometry}"; then
    log "repairing HDMI geometry '${geometry:-none}' on ${output}"
    configure_display "${output}"
    geometry_repaired=1
    xrandr_output="$(query_display)"
    geometry="$(active_geometry_for_output "${xrandr_output}" "${output}")"
    audio_state="$(audio_state_for_output "${xrandr_output}" "${output}")"
  fi

  if truthy_env "${MOTION_LEVELS_FORCE_ALSA_OUTPUT}" && [ "${audio_state}" != "on" ]; then
    log "repairing HDMI audio state '${audio_state}' on ${output}"
    enable_hdmi_audio_output "${output}"
    hdmi_audio_repaired=1
    xrandr_output="$(query_display)"
    audio_state="$(audio_state_for_output "${xrandr_output}" "${output}")"
  fi
  live_alsa_device="$(resolve_live_hdmi_alsa_device "${output}")" || live_alsa_device=""

  alsa_device_changed=0
  if truthy_env "${MOTION_LEVELS_FORCE_ALSA_OUTPUT}" \
    && [ "${alsa_state_was_initialized}" -eq 1 ] \
    && [ -n "${live_alsa_device}" ] \
    && [ "${previous_alsa_device}" != "${live_alsa_device}" ]; then
    alsa_device_changed=1
  fi
  alsa_device_state_initialized=1
  last_live_hdmi_alsa_device="${live_alsa_device}"
  if truthy_env "${MOTION_LEVELS_FORCE_ALSA_OUTPUT}" \
    && [ -n "${live_alsa_device}" ] \
    && { [ "${hdmi_audio_repaired}" -eq 1 ] || [ "${alsa_device_changed}" -eq 1 ]; }; then
    configure_hdmi_alsa_controls "${live_alsa_device}"
  fi

  if ! display_geometry_is_usable "${geometry}"; then
    display_state_initialized=1
    last_display_output="${output}"
    last_display_geometry="${geometry}"
    restart_kiosk_if_needed "bad HDMI geometry '${geometry:-none}' on ${output}"
    return 0
  fi

  state_changed=0
  if [ "${state_was_initialized}" -eq 1 ] \
    && { [ "${previous_output}" != "${output}" ] || [ "${previous_geometry}" != "${geometry}" ]; }; then
    state_changed=1
  fi
  display_state_initialized=1
  last_display_output="${output}"
  last_display_geometry="${geometry}"

  if [ "${geometry_repaired}" -eq 1 ]; then
    queue_kiosk_restart "HDMI geometry changed from '${original_geometry:-none}' to '${geometry}' on ${output}"
  elif [ "${state_changed}" -eq 1 ]; then
    queue_kiosk_restart "display changed from '${previous_output:-none} ${previous_geometry:-none}' to '${output} ${geometry}'"
  elif [ "${alsa_device_changed}" -eq 1 ]; then
    queue_kiosk_restart "live HDMI ALSA device changed from '${previous_alsa_device:-fallback}' to '${live_alsa_device}'"
  fi

  if [ -n "${restart_pending_reason}" ]; then
    attempt_pending_kiosk_restart
    return 0
  fi

  if truthy_env "${MOTION_LEVELS_FORCE_ALSA_OUTPUT}" && [ -n "${audio_state}" ] && [ "${audio_state}" != "on" ]; then
    restart_kiosk_if_needed "HDMI audio state is '${audio_state}' on ${output}"
    return 0
  fi

  if ! chromium_running; then
    restart_kiosk_if_needed "Chromium kiosk is not running"
    return 0
  fi

  if ! display_client_healthy; then
    restart_kiosk_if_needed "player display heartbeat is unhealthy"
    return 0
  fi

  failure_count=0
}

main() {
  if [ "${1:-}" = "--mark-detector-down" ]; then
    record_hdmi_metrics_observation 0 0
    return 0
  fi

  while true; do
    watchdog_check
    sleep "${POLL_SECONDS}"
  done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
