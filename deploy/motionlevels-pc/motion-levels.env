# Motion Levels local appliance defaults.
# Installed to /etc/motion-levels/motion-levels.env if that file does not exist.

MOTION_LEVELS_CONTROLLER_HTTP=127.0.0.1:4101
MOTION_LEVELS_ENGINE_HTTP=127.0.0.1:4102

MOTION_LEVELS_CONTROLLER_FRAMES=127.0.0.1:4201
MOTION_LEVELS_CONTROLLER_INPUT_EVENTS=127.0.0.1:4202

MOTION_LEVELS_FLOOR_RECV_PORT=7800
MOTION_LEVELS_LED_BROADCAST_IP=255.255.255.255
MOTION_LEVELS_LED_BROADCAST_PORT=4626

MOTION_LEVELS_PLATFORM_URL=https://platform.motionlevels.obis.dev
MOTION_LEVELS_PLATFORM_ASSET_CACHE_DIR=/var/lib/motion-levels/platform-asset-cache
# Room name shown on the platform (operations, history, session pages).
MOTION_LEVELS_CONTROLLER_LABEL=Zaragoza Caracol 1
# Tailnet hostname for the platform gateway links (Menu/Display/Controller/Engine).
# Kept separate from the label so the room can be renamed freely.
MOTION_LEVELS_CONTROLLER_HOSTNAME=motionlevels-1
# Controller frame recording is opt-in; leave upload disabled by default.
MOTION_LEVELS_RECORDING_UPLOAD_PLATFORM_URL=
MOTION_LEVELS_LIVE_PUSH_PLATFORM_URL=https://platform.motionlevels.obis.dev
MOTION_LEVELS_LIVE_PUSH_FPS=5
MOTION_LEVELS_LIVE_PUSH_TIMEOUT=10s

MOTION_LEVELS_REFRESH_FPS=50
MOTION_LEVELS_ENGINE_FPS=50
MOTION_LEVELS_ENGINE_BRIGHTNESS=80
MOTION_LEVELS_DISPLAY_SNAPSHOT_FPS=4
MOTION_LEVELS_REPLAY_MAX_LOCAL_BYTES=536870912

MOTION_LEVELS_PLAYER_URL=http://127.0.0.1/display/
MOTION_LEVELS_PLAYER_PROFILE=/var/lib/motion-levels/rebuild-player-chromium
MOTION_LEVELS_PLAYER_WINDOW_SIZE=auto
MOTION_LEVELS_HDMI_ALSA_DEVICE=plughw:0,5
MOTION_LEVELS_XRANDR_MODE=1920x1080
MOTION_LEVELS_XRANDR_RATE=60
MOTION_LEVELS_FORCE_ALSA_OUTPUT=1

# Camera snapshot helper. Store secrets only on the appliance, preferably in
# /etc/motion-levels/camera.env as MOTION_LEVELS_CAMERA_PASSWORD.
MOTION_LEVELS_CAMERA_USER=motionlevels
MOTION_LEVELS_CAMERA_128_HOST=192.168.1.128
MOTION_LEVELS_CAMERA_129_HOST=192.168.1.129
MOTION_LEVELS_CAMERA_130_HOST=192.168.1.130
MOTION_LEVELS_CAMERA_FPS=2
MOTION_LEVELS_CAMERA_JPEG_QUALITY=55
