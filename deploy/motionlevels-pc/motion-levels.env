# Motion Levels local appliance defaults.
# Installed to /etc/motion-levels/motion-levels.env if that file does not exist.

MOTION_LEVELS_CONTROLLER_HTTP=127.0.0.1:4101
MOTION_LEVELS_ENGINE_HTTP=127.0.0.1:4102

MOTION_LEVELS_CONTROLLER_FRAMES=127.0.0.1:4201
MOTION_LEVELS_CONTROLLER_INPUT_EVENTS=127.0.0.1:4202

MOTION_LEVELS_FLOOR_RECV_PORT=7800
MOTION_LEVELS_LED_BROADCAST_IP=255.255.255.255
MOTION_LEVELS_LED_BROADCAST_PORT=4626

MOTION_LEVELS_PLATFORM_URL=https://platform.motionlevels.obis.dev
MOTION_LEVELS_PLATFORM_ASSET_CACHE_DIR=/var/lib/motion-levels/platform-asset-cache
# Room name shown on the platform (operations, history, session pages).
MOTION_LEVELS_CONTROLLER_LABEL=Zaragoza Caracol 1
# Tailnet hostname for the platform gateway links (Menu/Display/Controller/Engine).
# Kept separate from the label so the room can be renamed freely.
MOTION_LEVELS_CONTROLLER_HOSTNAME=motionlevels-1
# Controller frame recording is opt-in; leave upload disabled by default.
MOTION_LEVELS_RECORDING_UPLOAD_PLATFORM_URL=
MOTION_LEVELS_LIVE_PUSH_PLATFORM_URL=https://platform.motionlevels.obis.dev
MOTION_LEVELS_LIVE_PUSH_FPS=5
MOTION_LEVELS_LIVE_PUSH_TIMEOUT=10s

MOTION_LEVELS_REFRESH_FPS=50
MOTION_LEVELS_ENGINE_FPS=50
MOTION_LEVELS_ENGINE_BRIGHTNESS=100
MOTION_LEVELS_DISPLAY_SNAPSHOT_FPS=4
MOTION_LEVELS_REPLAY_MAX_LOCAL_BYTES=536870912
MOTION_LEVELS_CAMERA_RECORDER_URL=http://127.0.0.1:8030
MOTION_LEVELS_CAMERA_RECORDER_TIMEOUT=20s
MOTION_LEVELS_CAMERA_RECORDER_BACKEND=fake
MOTION_LEVELS_CAMERA_RECORDINGS_ROOT=/var/lib/motion-levels/camera-recordings
MOTION_LEVELS_CAMERA_DELETE_LOCAL_AFTER_UPLOAD=1
MOTION_LEVELS_CAMERA_HDR_DEFAULT=1
MOTION_LEVELS_CAMERA_VIDEO_PROJECTION_DEFAULT=regular
MOTION_LEVELS_INSTA360_VIDEO_RESOLUTION=1080p30
MOTION_LEVELS_CAMERA_SESSION_SEGMENT_SECONDS=120
MOTION_LEVELS_CAMERA_SESSION_MAX_SECONDS=7200
MOTION_LEVELS_CAMERA_DELETE_REMOTE_AFTER_DOWNLOAD=1
# For Insta360 X4/X5 SDK control, connect the camera by USB and select Android
# mode on the camera prompt. Linux should then show USB vendor 2e1a.
# Configure real camera capture on the appliance in
# /etc/motion-levels/camera-recorder.env, for example:
# MOTION_LEVELS_CAMERA_RECORDER_BACKEND=command
# MOTION_LEVELS_CAMERA_REGULAR_MEDIA_EXTENSION=.mp4
# MOTION_LEVELS_CAMERA_360_MEDIA_EXTENSION=.insv
# MOTION_LEVELS_CAMERA_PHOTO_EXTENSION=.insp
# MOTION_LEVELS_CAMERA_START_COMMAND=/usr/local/bin/motion-levels-insta360 start
# MOTION_LEVELS_CAMERA_STOP_COMMAND=/usr/local/bin/motion-levels-insta360 stop
# MOTION_LEVELS_CAMERA_PHOTO_COMMAND=/usr/local/bin/motion-levels-insta360 photo
# MOTION_LEVELS_CAMERA_RCLONE_DEST=motionlevels-drive:Partidas
# USB/UVC camera recording can be enabled with:
# MOTION_LEVELS_CAMERA_RECORDER_BACKEND=ffmpeg
# MOTION_LEVELS_CAMERA_RECORDER_DEVICE=/dev/v4l/by-id/usb-Insta360_...-video-index0
# MOTION_LEVELS_CAMERA_RECORDER_INPUT_FORMAT=mjpeg
# MOTION_LEVELS_CAMERA_RECORDER_VIDEO_SIZE=2880x1440
# MOTION_LEVELS_CAMERA_RECORDER_FRAMERATE=30
MOTION_LEVELS_CAMERA_RCLONE_DEST=

MOTION_LEVELS_SECURITY_RECORDER_ENABLED=1
MOTION_LEVELS_SECURITY_CAMERA_ID=130
MOTION_LEVELS_SECURITY_CAMERA_LABEL=Cámara frontal
MOTION_LEVELS_SECURITY_CAMERA_ROLE=front
MOTION_LEVELS_SECURITY_RECORDINGS_ROOT=/var/lib/motion-levels/security-recordings
MOTION_LEVELS_SECURITY_RECORDER_AUDIO=0
MOTION_LEVELS_SECURITY_RECORDER_SEGMENT_SECONDS=300
MOTION_LEVELS_SECURITY_RECORDER_RETENTION_DAYS=14
MOTION_LEVELS_SECURITY_RECORDER_DELETE_LOCAL_AFTER_UPLOAD=1

MOTION_LEVELS_PLAYER_URL=http://127.0.0.1/display/
MOTION_LEVELS_PLAYER_PROFILE=/var/lib/motion-levels/rebuild-player-chromium
MOTION_LEVELS_PLAYER_WINDOW_SIZE=auto
MOTION_LEVELS_HDMI_ALSA_DEVICE=plughw:0,5
MOTION_LEVELS_XRANDR_MODE=1920x1080
MOTION_LEVELS_XRANDR_RATE=60
MOTION_LEVELS_FORCE_ALSA_OUTPUT=1
MOTION_LEVELS_HDMI_WATCHDOG_INTERVAL=10
MOTION_LEVELS_HDMI_WATCHDOG_FAILURES=3
MOTION_LEVELS_HDMI_WATCHDOG_RESTART_COOLDOWN=45

# Camera snapshot helper. Store secrets only on the appliance, preferably in
# /etc/motion-levels/camera.env as MOTION_LEVELS_CAMERA_PASSWORD.
MOTION_LEVELS_CAMERA_USER=motionlevels
MOTION_LEVELS_CAMERA_128_HOST=192.168.1.128
MOTION_LEVELS_CAMERA_129_HOST=192.168.1.129
MOTION_LEVELS_CAMERA_130_HOST=192.168.1.130
MOTION_LEVELS_CAMERA_FPS=2
MOTION_LEVELS_CAMERA_JPEG_QUALITY=55
