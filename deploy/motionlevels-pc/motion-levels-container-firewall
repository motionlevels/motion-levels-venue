#!/bin/sh
set -eu

rules=/etc/motion-levels/venue/firewall.nft

case "${1:-start}" in
  start|reload)
    /usr/sbin/nft -f "$rules"
    ;;
  stop)
    # Keep the restrictive table installed while Docker containers are being
    # stopped or restarted. An unused source subnet makes the policy inert.
    :
    ;;
  *)
    echo "usage: $0 {start|reload|stop}" >&2
    exit 2
    ;;
esac
