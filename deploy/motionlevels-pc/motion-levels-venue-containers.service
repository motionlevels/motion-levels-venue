[Unit]
Description=Motion Levels pinned venue containers
Requires=docker.service motion-levels-audio.socket motion-levels-container-firewall.service
After=docker.service motion-levels-audio.socket motion-levels-container-firewall.service network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
ConditionPathExists=/etc/motion-levels/venue/current.env

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/
ExecCondition=/bin/grep -qx VENUE_MODE=containers /etc/motion-levels/venue/current.env
ExecStartPre=/bin/sh -ec 'address=$$(sed -n "s/^VENUE_TAILSCALE_IPV4=//p" /etc/motion-levels/venue/current.env); test -n "$$address"; attempt=0; until /usr/sbin/ip -4 -o address show dev tailscale0 | /usr/bin/grep -Fq " $$address/"; do attempt=$$((attempt + 1)); test "$$attempt" -lt 60; /usr/bin/sleep 1; done'
ExecStartPre=/bin/sh -ec 'compose_file=$$(sed -n "s/^VENUE_COMPOSE_FILE=//p" /etc/motion-levels/venue/current.env); test -n "$$compose_file"; exec /usr/bin/docker compose --env-file /etc/motion-levels/venue/current.env -f "$$compose_file" config --quiet'
ExecStart=/bin/sh -ec 'compose_file=$$(sed -n "s/^VENUE_COMPOSE_FILE=//p" /etc/motion-levels/venue/current.env); exec /usr/bin/docker compose --env-file /etc/motion-levels/venue/current.env -f "$$compose_file" up -d --no-build --wait --wait-timeout 240'
ExecReload=/bin/sh -ec 'compose_file=$$(sed -n "s/^VENUE_COMPOSE_FILE=//p" /etc/motion-levels/venue/current.env); exec /usr/bin/docker compose --env-file /etc/motion-levels/venue/current.env -f "$$compose_file" up -d --no-build --wait --wait-timeout 240'
ExecStop=/bin/sh -ec 'compose_file=$$(sed -n "s/^VENUE_COMPOSE_FILE=//p" /etc/motion-levels/venue/current.env); test -z "$$compose_file" || exec /usr/bin/docker compose --env-file /etc/motion-levels/venue/current.env -f "$$compose_file" stop --timeout 120'
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
