[Unit]
Description=Motion Levels player display web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/motion-levels/rebuild/apps/player-display/dist
ExecStart=/usr/bin/python3 -m http.server 5175 --bind 0.0.0.0 --directory /opt/motion-levels/rebuild/apps/player-display/dist
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
