:80 {
	encode zstd gzip

	handle_path /controller/* {
		reverse_proxy 127.0.0.1:4101
	}

	handle /controller {
		rewrite * /
		reverse_proxy 127.0.0.1:4101
	}

	handle /ws {
		reverse_proxy 127.0.0.1:4101
	}

	handle_path /engine/* {
		reverse_proxy 127.0.0.1:4102
	}

	# These platform-backed routes are available only when the request really
	# arrived on the venue Ethernet address. A Host header alone is spoofable.
	@platform_tv {
		path /tv /tv/
		expression {http.request.local.host} == "192.168.1.142"
	}
	handle @platform_tv {
		rewrite * /salas/motionlevels-1/tv
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	@platform_cameras {
		path /cameras /cameras/
		expression {http.request.local.host} == "192.168.1.142"
	}
	handle @platform_cameras {
		root * /srv/venue
		rewrite * /cameras.html
		header Cache-Control "no-store"
		file_server
	}

	# Snapshot data remains reachable through Tailscale for the platform.
	handle /cam/* {
		reverse_proxy 127.0.0.1:8020
	}

	handle_path /camera-recorder/* {
		reverse_proxy 127.0.0.1:8040
	}

	@platform_next {
		path /_next/*
		expression {http.request.local.host} == "192.168.1.142"
	}
	handle @platform_next {
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	@platform_rooms {
		path /api/rooms/*
		expression {http.request.local.host} == "192.168.1.142"
	}
	handle @platform_rooms {
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	@platform_live_floor {
		path /api/live-floor/*
		expression {http.request.local.host} == "192.168.1.142"
	}
	handle @platform_live_floor {
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	handle /motion-levels-icon.png {
		root * /srv/player-menu
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /motion-levels-icon.webp {
		root * /srv/player-menu
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	redir /menu /menu/
	handle_path /menu/* {
		root * /srv/player-menu
		@menu_assets path /assets/*
		header @menu_assets Cache-Control "public, max-age=31536000, immutable"
		@menu_index path / /index.html
		header @menu_index Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}

	redir /display /display/
	handle_path /display/* {
		root * /srv/player-display
		@display_assets path /assets/*
		header @display_assets Cache-Control "public, max-age=31536000, immutable"
		@display_index path / /index.html
		header @display_index Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}

	redir /games /games/
	handle_path /games/* {
		root * /srv/games
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /stack.json {
		root * /srv/runtime
		file_server
	}

	redir /status /engine/api/status
	redir / /menu/
}
