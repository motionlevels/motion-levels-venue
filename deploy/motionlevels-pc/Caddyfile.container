(venue_common) {
	encode zstd gzip

	handle /controller/health {
		rewrite * /health
		reverse_proxy floor-core:4101
	}

	handle /controller/metrics {
		rewrite * /metrics
		reverse_proxy floor-core:4101
	}

	handle /controller* {
		respond 404
	}

	handle_path /engine/* {
		reverse_proxy engine-core:4102 {
			header_up X-Motion-Levels-Engine-Token "{$MOTION_LEVELS_ENGINE_TOKEN}"
		}
	}

	# Snapshot data remains reachable through Tailscale for the platform, but
	# the helper itself is not published on a host port.
	handle /cam/* {
		reverse_proxy camera-helper-api:8020
	}

	# X5 support remains a configuration-only restoration. The route is absent
	# by default and becomes active only when the release manifest opts in.
	handle_path /camera-recorder/* {
		@x5_enabled expression `"{$MOTION_LEVELS_X5_ENABLED:0}" == "1"`
		route {
			reverse_proxy @x5_enabled {$MOTION_LEVELS_X5_UPSTREAM:http://172.30.53.1:8040}
			respond 404
		}
	}

	handle /motion-levels-icon.png {
		root * /srv/player-menu
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /motion-levels-icon.webp {
		root * /srv/player-menu
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	redir /menu /menu/
	handle_path /menu/* {
		root * /srv/player-menu
		@menu_assets path /assets/*
		header @menu_assets Cache-Control "public, max-age=31536000, immutable"
		@menu_index path / /index.html
		header @menu_index Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}

	redir /display /display/
	handle_path /display/* {
		root * /srv/player-display
		@display_assets path /assets/*
		header @display_assets Cache-Control "public, max-age=31536000, immutable"
		@display_index path / /index.html
		header @display_index Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}

	redir /games /games/
	handle_path /games/* {
		root * /srv/games
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /stack.json {
		root * /srv/runtime
		file_server
	}

	redir /status /engine/api/status
	redir / /menu/
}

(venue_lan_only) {
	# Docker publishes this listener only on the venue Ethernet address. The
	# separate socket preserves the interface boundary after destination NAT;
	# no spoofable Host header is used for authorization.
	@platform_tv path /tv /tv/
	handle @platform_tv {
		rewrite * /salas/motionlevels-1/tv
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	@platform_cameras path /cameras /cameras/
	handle @platform_cameras {
		root * /srv/venue
		rewrite * /cameras.html
		header Cache-Control "no-store"
		file_server
	}

	handle /_next/* {
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	handle /api/rooms/* {
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	handle /api/live-floor/* {
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}
}

(venue_general_only) {
	# Make the wired-only surface explicitly absent on loopback/Tailscale rather
	# than relying on Caddy's empty fallthrough response.
	@lan_only_paths path /tv /tv/ /cameras /cameras/ /_next/* /api/rooms/* /api/live-floor/*
	handle @lan_only_paths {
		respond 404
	}
}

# Loopback and Tailscale are published to the general listener. The player
# reaches this same listener directly over the private display bridge.
:8080 {
	import venue_general_only
	import venue_common
}

# Only the fixed Ethernet host address is published to this enriched listener.
:8081 {
	import venue_lan_only
	import venue_common
}
