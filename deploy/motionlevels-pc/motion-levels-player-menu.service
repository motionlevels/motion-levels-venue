[Unit]
Description=Motion Levels player menu web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/motion-levels/motion-levels.env
WorkingDirectory=/opt/motion-levels/rebuild/apps/player-menu/dist
ExecStart=/usr/bin/python3 -m http.server ${MOTION_LEVELS_PLAYER_MENU_PORT} --bind ${MOTION_LEVELS_PLAYER_MENU_HOST} --directory /opt/motion-levels/rebuild/apps/player-menu/dist
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
