[Unit]
Description=Motion Levels floor controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/motion-levels/rebuild
EnvironmentFile=/etc/motion-levels/motion-levels.env
EnvironmentFile=-/etc/motion-levels/platform.env
ExecStart=/opt/motion-levels/rebuild/bin/floor-controller \
  -http ${MOTION_LEVELS_CONTROLLER_HTTP} \
  -frames ${MOTION_LEVELS_CONTROLLER_FRAMES} \
  -input-events ${MOTION_LEVELS_CONTROLLER_INPUT_EVENTS} \
  -recv-port ${MOTION_LEVELS_FLOOR_RECV_PORT} \
  -broadcast-ip ${MOTION_LEVELS_LED_BROADCAST_IP} \
  -broadcast-port ${MOTION_LEVELS_LED_BROADCAST_PORT} \
  -controller-id-file /opt/motion-levels/rebuild/var/floor-controller/controller-id \
  -record-frames "" \
  -record-compression none \
  -record-post-compression zstd \
  -record-segment-bytes 268435456 \
  -record-segment-duration 10m \
  -record-delete-raw-after 1h \
  -record-max-pending-raw-bytes 4294967296 \
  -record-upload-platform-url "" \
  -record-upload-queue-size 256 \
  -record-upload-timeout 5m \
  -zstd-path /usr/bin/zstd \
  -refresh-fps ${MOTION_LEVELS_REFRESH_FPS} \
  -engine-fade-delay 2s \
  -engine-fade-duration 3s
Restart=always
RestartSec=2
Nice=-5
CPUWeight=1000
LimitNOFILE=65536
Environment=GOMAXPROCS=2

[Install]
WantedBy=multi-user.target
