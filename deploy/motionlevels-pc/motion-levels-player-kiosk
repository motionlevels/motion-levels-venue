#!/usr/bin/env bash
# Motion Levels Kiosk Launcher
# Configures the display and launches the Chromium player kiosk under xinit.
set -euo pipefail

# 1. Read kiosk settings from the systemd-style environment file without
# sourcing it as shell; labels and names may contain spaces.
ENV_FILE=/etc/motion-levels/motion-levels.env

env_file_value() {
  local key="$1"
  local fallback="${2:-}"
  local value=""

  if [ -f "${ENV_FILE}" ]; then
    value="$(awk -v key="${key}" '
      /^[[:space:]]*#/ { next }
      /^[[:space:]]*$/ { next }
      index($0, key "=") == 1 {
        sub(/^[^=]*=/, "")
        print
        exit
      }
    ' "${ENV_FILE}")"
  fi

  value="${value%$'\r'}"
  if [ "${#value}" -ge 2 ]; then
    local first="${value:0:1}"
    local last="${value: -1}"
    if { [ "${first}" = '"' ] && [ "${last}" = '"' ]; } || { [ "${first}" = "'" ] && [ "${last}" = "'" ]; }; then
      value="${value:1:${#value}-2}"
    fi
  fi

  if [ -n "${value}" ]; then
    printf '%s' "${value}"
  else
    printf '%s' "${fallback}"
  fi
}

MOTION_LEVELS_XRANDR_MODE="$(env_file_value MOTION_LEVELS_XRANDR_MODE)"
MOTION_LEVELS_XRANDR_RATE="$(env_file_value MOTION_LEVELS_XRANDR_RATE 60)"
MOTION_LEVELS_XRANDR_OUTPUT="$(env_file_value MOTION_LEVELS_XRANDR_OUTPUT)"
MOTION_LEVELS_PLAYER_PROFILE="$(env_file_value MOTION_LEVELS_PLAYER_PROFILE /var/lib/motion-levels/rebuild-player-chromium)"
MOTION_LEVELS_PLAYER_URL="$(env_file_value MOTION_LEVELS_PLAYER_URL http://127.0.0.1/display/)"
MOTION_LEVELS_FORCE_ALSA_OUTPUT="$(env_file_value MOTION_LEVELS_FORCE_ALSA_OUTPUT 0)"
MOTION_LEVELS_HDMI_ALSA_DEVICE="$(env_file_value MOTION_LEVELS_HDMI_ALSA_DEVICE)"
MOTION_LEVELS_PLAYER_WINDOW_SIZE="${MOTION_LEVELS_XRANDR_MODE:-1920x1080}"
MOTION_LEVELS_PLAYER_WINDOW_SIZE="${MOTION_LEVELS_PLAYER_WINDOW_SIZE//x/,}"

truthy_env() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

query_display() {
  /usr/bin/xrandr --query 2>/dev/null || true
}

display_output_from_query() {
  local query="$1"
  local preferred_output="${2:-}"
  awk -v preferred="${preferred_output}" '
    $2 == "connected" && $1 ~ /^HDMI([.-]|$)/ {
      if (first_hdmi == "") {
        first_hdmi = $1
      }
      active = 0
      for (field = 3; field <= NF; field += 1) {
        if ($field ~ /^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+/) {
          active = 1
          break
        }
      }
      if ($1 == preferred) {
        preferred_hdmi = $1
      }
      if (active && first_active_hdmi == "") {
        first_active_hdmi = $1
      }
    }
    END {
      if (preferred_hdmi != "") {
        print preferred_hdmi
      } else if (first_active_hdmi != "") {
        print first_active_hdmi
      } else if (first_hdmi != "") {
        print first_hdmi
      }
    }
  ' <<<"${query}"
}

active_geometry_for_output() {
  local query="$1"
  local output="$2"
  awk -v output="${output}" '
    $1 == output && $2 == "connected" {
      for (field = 3; field <= NF; field += 1) {
        if ($field ~ /^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+/) {
          print $field
          exit
        }
      }
    }
  ' <<<"${query}"
}

display_geometry_is_usable() {
  local geometry="$1"
  local size="${geometry%%[+-]*}"
  local expected_size="${MOTION_LEVELS_XRANDR_MODE:-}"

  [ -n "${geometry}" ] \
    && [ "${size}" != "1024x768" ] \
    && [[ "${geometry}" == *+0+0 ]] \
    && { [ -z "${expected_size}" ] || [ "${size}" = "${expected_size}" ]; }
}

eld_is_live_hdmi() {
  local eld_file="$1"
  awk '
    $1 == "monitor_present" && $2 == "1" { monitor_present = 1 }
    $1 == "eld_valid" && $2 == "1" { eld_valid = 1 }
    $1 == "connection_type" && $2 == "HDMI" { hdmi = 1 }
    END { exit !(monitor_present && eld_valid && hdmi) }
  ' "${eld_file}"
}

alsa_pcm_device_for_eld() {
  local card_dir="$1"
  local eld_index="$2"
  local info_file device="" matched_device=""

  for info_file in "${card_dir}"/pcm*p/info; do
    [ -r "${info_file}" ] || continue
    if ! awk -v eld_index="${eld_index}" '
      $1 == "stream:" && $2 == "PLAYBACK" { playback = 1 }
      $1 == "id:" && $2 == "HDMI" && $3 == eld_index { matching_id = 1 }
      END { exit !(playback && matching_id) }
    ' "${info_file}"; then
      continue
    fi

    device="$(awk '$1 == "device:" && $2 ~ /^[0-9]+$/ { print $2; exit }' "${info_file}")"
    [ -n "${device}" ] || continue
    # Never guess when procfs exposes more than one PCM for the same ELD.
    [ -z "${matched_device}" ] || return 1
    matched_device="${device}"
  done

  [ -n "${matched_device}" ] || return 1
  printf '%s' "${matched_device}"
}

hdmi_eld_index_for_output() {
  local output="$1"

  if [[ "${output}" =~ ^HDMI(-A)?-([1-9][0-9]*)$ ]]; then
    printf '%s' "$((10#${BASH_REMATCH[2]} - 1))"
    return 0
  fi
  return 1
}

resolve_live_hdmi_alsa_device() {
  local output="$1"
  local asound_root="${MOTION_LEVELS_PROC_ASOUND_ROOT:-/proc/asound}"
  local eld_file eld_index card_dir card_basename card_number pcm_device
  local candidate="" resolved_device=""

  eld_index="$(hdmi_eld_index_for_output "${output}")" || return 1
  for eld_file in "${asound_root}"/card*/eld#*."${eld_index}"; do
    [ -r "${eld_file}" ] || continue
    eld_is_live_hdmi "${eld_file}" || continue

    card_dir="${eld_file%/*}"
    card_basename="${card_dir##*/}"
    if [[ ! "${card_basename}" =~ ^card([0-9]+)$ ]]; then
      continue
    fi
    card_number="${BASH_REMATCH[1]}"
    pcm_device="$(alsa_pcm_device_for_eld "${card_dir}" "${eld_index}")" || continue
    candidate="plughw:${card_number},${pcm_device}"

    # The same connector ordinal on multiple sound cards is still ambiguous.
    [ -z "${resolved_device}" ] || return 1
    resolved_device="${candidate}"
  done

  [ -n "${resolved_device}" ] || return 1
  printf '%s' "${resolved_device}"
}

resolve_hdmi_alsa_device_with_fallback() {
  local output="$1"
  local attempt discovered_device=""

  if [ -n "${output}" ]; then
    # ELD commonly becomes valid shortly after the display modeset.
    for ((attempt = 1; attempt <= 5; attempt += 1)); do
      if discovered_device="$(resolve_live_hdmi_alsa_device "${output}")"; then
        printf '%s' "${discovered_device}"
        return 0
      fi
      [ "${attempt}" -eq 5 ] || sleep 1
    done
  fi

  if [ -n "${MOTION_LEVELS_HDMI_ALSA_DEVICE}" ]; then
    echo "Warning: no unique live HDMI ALSA PCM for ${output:-no output}; using configured fallback ${MOTION_LEVELS_HDMI_ALSA_DEVICE}." >&2
    printf '%s' "${MOTION_LEVELS_HDMI_ALSA_DEVICE}"
    return 0
  fi
  return 1
}

alsa_card_from_device() {
  local device="$1"

  if [[ "${device}" =~ ^plughw:([0-9]+),[0-9]+$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
    return 0
  fi
  return 1
}

apply_display_mode() {
  local output="$1"
  local mode="$2"
  local rate="$3"

  /usr/bin/xrandr --output "${output}" --auto --primary --pos 0x0 2>/dev/null || true
  if [ -n "${mode}" ]; then
    /usr/bin/xrandr --output "${output}" --mode "${mode}" --rate "${rate}" --primary --pos 0x0 2>/dev/null || true
  fi
}

# 2. Enable and configure the connected display output.
# Whenever an output (HDMI/DP) is connected we want the player visible on it,
# so always bring the output up at its preferred mode first. Previously we only
# attempted an explicit --mode and swallowed failures, which could leave a
# connected TV on a phantom default resolution (e.g. 1024x768) with no signal.
configure_display() {
  local xrandr_output output mode rate geometry
  mode="${MOTION_LEVELS_XRANDR_MODE:-}"
  rate="${MOTION_LEVELS_XRANDR_RATE:-60}"
  # The output may appear a few seconds after X starts (slow EDID, TV powering
  # on), and the modeset sometimes silently leaves X on the 1024x768 dummy
  # default. Retry detection AND the modeset until a real geometry is active, so
  # the TV reliably ends up on a proper resolution instead of a phantom one.
  for ((_attempt = 1; _attempt <= 15; _attempt += 1)); do
    xrandr_output="$(query_display)"
    output="$(display_output_from_query "${xrandr_output}" "${MOTION_LEVELS_XRANDR_OUTPUT}")"
    if [ -n "${output}" ]; then
      # Preferred mode first so a connected TV always gets a real signal, then
      # the configured mode on top if it is available.
      apply_display_mode "${output}" "${mode}" "${rate}"
      xrandr_output="$(query_display)"
      geometry="$(active_geometry_for_output "${xrandr_output}" "${output}")"
      if display_geometry_is_usable "${geometry}"; then
        echo "Display configured: ${output} ${geometry}"
        return 0
      fi
    fi
    sleep 1
  done
  echo "Warning: could not configure a connected display after retries; leaving X at its default."
}

enable_hdmi_audio_output() {
  local output="$1"
  if ! truthy_env "${MOTION_LEVELS_FORCE_ALSA_OUTPUT}"; then
    return 0
  fi

  if [ -n "${output}" ]; then
    /usr/bin/xrandr --output "${output}" --set audio on 2>/dev/null || true
  fi
}

configure_audio_output() {
  local alsa_device="$1"
  local control alsa_card=""
  if ! truthy_env "${MOTION_LEVELS_FORCE_ALSA_OUTPUT}"; then
    return 0
  fi

  alsa_card="$(alsa_card_from_device "${alsa_device}")" || true
  if [ -n "${alsa_card}" ] && command -v /usr/bin/amixer >/dev/null 2>&1; then
    for control in IEC958 "IEC958,0" "IEC958,1" "IEC958,2"; do
      /usr/bin/amixer -q -c "${alsa_card}" sset "${control}" unmute 2>/dev/null || true
      /usr/bin/amixer -q -c "${alsa_card}" sset "${control}" on 2>/dev/null || true
    done
  fi

  if [ -n "${alsa_card}" ] && command -v /usr/sbin/alsactl >/dev/null 2>&1; then
    /usr/sbin/alsactl store "${alsa_card}" >/dev/null 2>&1 || true
  fi
}

main() {
  local screen_query screen_output screen_geometry screen_size screen_width screen_height
  local user_data_dir target_url resolved_alsa_device=""
  local -a chrome_flags

  configure_display

  # Capture the active screen geometry so Chromium can be forced to fill it. There
  # is no window manager under this bare xinit session, so --kiosk alone keeps the
  # Chromium window at its previously saved size; an explicit --window-size makes
  # the player cover the whole TV even after the output resolution changes.
  screen_query="$(query_display)"
  screen_output="$(display_output_from_query "${screen_query}" "${MOTION_LEVELS_XRANDR_OUTPUT}")"
  screen_geometry="$(active_geometry_for_output "${screen_query}" "${screen_output}")"
  screen_size="${screen_geometry%%[+-]*}"
  screen_width="${screen_size%x*}"
  screen_height="${screen_size#*x}"

  # Enabling the RandR audio property makes the kernel publish the connector's
  # ELD. Resolve ALSA only afterwards so a recent hotplug can select its PCM.
  enable_hdmi_audio_output "${screen_output}"
  if truthy_env "${MOTION_LEVELS_FORCE_ALSA_OUTPUT}"; then
    resolved_alsa_device="$(resolve_hdmi_alsa_device_with_fallback "${screen_output}")"
  fi
  configure_audio_output "${resolved_alsa_device}"

  # 3. Ensure player user data directory exists
  user_data_dir="${MOTION_LEVELS_PLAYER_PROFILE}"
  mkdir -p "${user_data_dir}"

  # 4. Hide mouse cursor if unclutter is available
  if command -v /usr/bin/unclutter >/dev/null 2>&1; then
    /usr/bin/unclutter -idle 0.1 -root &
  fi

  # 5. Build Chromium arguments
  chrome_flags=(
    --kiosk
    --no-first-run
    --new-window
    --user-data-dir="${user_data_dir}"
    --noerrdialogs
    --disable-infobars
    --disable-session-crashed-bubble
    --disable-translate
    --disable-features=Translate
    "--window-position=0,0"
    --window-size="${MOTION_LEVELS_PLAYER_WINDOW_SIZE}"
    --start-fullscreen
    --check-for-update-interval=31536000
    --autoplay-policy=no-user-gesture-required
    --disable-background-timer-throttling
    --disable-backgrounding-occluded-windows
    --disable-renderer-backgrounding
  )

  # Route Chromium directly to the ELD-matched HDMI PCM. The inventory-owned
  # device and /etc/asound.conf remain fallbacks, while the explicit flag lets
  # a kiosk restart follow a TV moved between HDMI ports.
  if truthy_env "${MOTION_LEVELS_FORCE_ALSA_OUTPUT}" && [ -n "${resolved_alsa_device}" ]; then
    chrome_flags+=( "--alsa-output-device=${resolved_alsa_device}" )
  fi

  # Force the window to cover the whole screen (no WM to maximise it for us).
  if [ -n "${screen_width:-}" ] && [ -n "${screen_height:-}" ]; then
    chrome_flags+=( "--window-position=0,0" "--window-size=${screen_width},${screen_height}" )
  fi

  # Chromium won't run as root without --no-sandbox
  if [ "$(id -u)" -eq 0 ]; then
    chrome_flags+=( --no-sandbox )
  fi

  target_url="${MOTION_LEVELS_PLAYER_URL}"
  echo "Starting Chromium kiosk pointing to ${target_url}..."
  exec /usr/bin/chromium "${chrome_flags[@]}" --app="${target_url}"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
