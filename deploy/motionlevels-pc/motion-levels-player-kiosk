#!/usr/bin/env bash
# Motion Levels Kiosk Launcher
# Configures the display and launches the Chromium player kiosk under xinit.
set -euo pipefail

# 1. Read kiosk settings from the systemd-style environment file without
# sourcing it as shell; labels and names may contain spaces.
ENV_FILE=/etc/motion-levels/motion-levels.env

env_file_value() {
  local key="$1"
  local fallback="${2:-}"
  local value=""

  if [ -f "${ENV_FILE}" ]; then
    value="$(awk -v key="${key}" '
      /^[[:space:]]*#/ { next }
      /^[[:space:]]*$/ { next }
      index($0, key "=") == 1 {
        sub(/^[^=]*=/, "")
        print
        exit
      }
    ' "${ENV_FILE}")"
  fi

  value="${value%$'\r'}"
  if [ "${#value}" -ge 2 ]; then
    local first="${value:0:1}"
    local last="${value: -1}"
    if { [ "${first}" = '"' ] && [ "${last}" = '"' ]; } || { [ "${first}" = "'" ] && [ "${last}" = "'" ]; }; then
      value="${value:1:${#value}-2}"
    fi
  fi

  if [ -n "${value}" ]; then
    printf '%s' "${value}"
  else
    printf '%s' "${fallback}"
  fi
}

MOTION_LEVELS_XRANDR_MODE="$(env_file_value MOTION_LEVELS_XRANDR_MODE)"
MOTION_LEVELS_XRANDR_RATE="$(env_file_value MOTION_LEVELS_XRANDR_RATE 60)"
MOTION_LEVELS_PLAYER_PROFILE="$(env_file_value MOTION_LEVELS_PLAYER_PROFILE /var/lib/motion-levels/rebuild-player-chromium)"
MOTION_LEVELS_PLAYER_URL="$(env_file_value MOTION_LEVELS_PLAYER_URL http://127.0.0.1/display/)"

# 2. Configure screen mode/rate if specified
if [ -n "${MOTION_LEVELS_XRANDR_MODE:-}" ]; then
  echo "Configuring display using xrandr..."
  # Detect connected output (usually HDMI-1, DP-1, etc.)
  OUTPUT=$(/usr/bin/xrandr --query | awk '/ connected/ { print $1; exit }')
  if [ -n "${OUTPUT}" ]; then
    /usr/bin/xrandr --output "${OUTPUT}" --mode "${MOTION_LEVELS_XRANDR_MODE}" --rate "${MOTION_LEVELS_XRANDR_RATE:-60}" || true
  else
    echo "Warning: No connected display output found for xrandr."
  fi
fi

# 3. Ensure player user data directory exists
USER_DATA_DIR="${MOTION_LEVELS_PLAYER_PROFILE}"
mkdir -p "${USER_DATA_DIR}"

# 4. Hide mouse cursor if unclutter is available
if command -v /usr/bin/unclutter >/dev/null 2>&1; then
  /usr/bin/unclutter -idle 0.1 -root &
fi

# 5. Build Chromium arguments
CHROME_FLAGS=(
  --kiosk
  --no-first-run
  --new-window
  --user-data-dir="${USER_DATA_DIR}"
  --noerrdialogs
  --disable-infobars
  --disable-session-crashed-bubble
  --disable-features=Translate
  --check-for-update-interval=31536000
  --autoplay-policy=no-user-gesture-required
)

# Chromium won't run as root without --no-sandbox
if [ "$(id -u)" -eq 0 ]; then
  CHROME_FLAGS+=( --no-sandbox )
fi

# Determine target URL
TARGET_URL="${MOTION_LEVELS_PLAYER_URL}"

echo "Starting Chromium kiosk pointing to ${TARGET_URL}..."
exec /usr/bin/chromium "${CHROME_FLAGS[@]}" "${TARGET_URL}"
