#!/usr/bin/env bash
# Motion Levels Kiosk Launcher
# Configures the display and launches the Chromium player kiosk under xinit.
set -euo pipefail

# 1. Read kiosk settings from the systemd-style environment file without
# sourcing it as shell; labels and names may contain spaces.
ENV_FILE=/etc/motion-levels/motion-levels.env

env_file_value() {
  local key="$1"
  local fallback="${2:-}"
  local value=""

  if [ -f "${ENV_FILE}" ]; then
    value="$(awk -v key="${key}" '
      /^[[:space:]]*#/ { next }
      /^[[:space:]]*$/ { next }
      index($0, key "=") == 1 {
        sub(/^[^=]*=/, "")
        print
        exit
      }
    ' "${ENV_FILE}")"
  fi

  value="${value%$'\r'}"
  if [ "${#value}" -ge 2 ]; then
    local first="${value:0:1}"
    local last="${value: -1}"
    if { [ "${first}" = '"' ] && [ "${last}" = '"' ]; } || { [ "${first}" = "'" ] && [ "${last}" = "'" ]; }; then
      value="${value:1:${#value}-2}"
    fi
  fi

  if [ -n "${value}" ]; then
    printf '%s' "${value}"
  else
    printf '%s' "${fallback}"
  fi
}

MOTION_LEVELS_XRANDR_MODE="$(env_file_value MOTION_LEVELS_XRANDR_MODE)"
MOTION_LEVELS_XRANDR_RATE="$(env_file_value MOTION_LEVELS_XRANDR_RATE 60)"
MOTION_LEVELS_PLAYER_PROFILE="$(env_file_value MOTION_LEVELS_PLAYER_PROFILE /var/lib/motion-levels/rebuild-player-chromium)"
MOTION_LEVELS_PLAYER_URL="$(env_file_value MOTION_LEVELS_PLAYER_URL http://127.0.0.1/display/)"
MOTION_LEVELS_FORCE_ALSA_OUTPUT="$(env_file_value MOTION_LEVELS_FORCE_ALSA_OUTPUT 0)"
MOTION_LEVELS_PLAYER_WINDOW_SIZE="${MOTION_LEVELS_XRANDR_MODE:-1920x1080}"
MOTION_LEVELS_PLAYER_WINDOW_SIZE="${MOTION_LEVELS_PLAYER_WINDOW_SIZE//x/,}"

truthy_env() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

# 2. Enable and configure the connected display output.
# Whenever an output (HDMI/DP) is connected we want the player visible on it,
# so always bring the output up at its preferred mode first. Previously we only
# attempted an explicit --mode and swallowed failures, which could leave a
# connected TV on a phantom default resolution (e.g. 1024x768) with no signal.
configure_display() {
  local output mode rate attempt geometry size
  mode="${MOTION_LEVELS_XRANDR_MODE:-}"
  rate="${MOTION_LEVELS_XRANDR_RATE:-60}"
  # The output may appear a few seconds after X starts (slow EDID, TV powering
  # on), and the modeset sometimes silently leaves X on the 1024x768 dummy
  # default. Retry detection AND the modeset until a real geometry is active, so
  # the TV reliably ends up on a proper resolution instead of a phantom one.
  for attempt in $(seq 1 15); do
    output=$(/usr/bin/xrandr --query 2>/dev/null | awk '/ connected/ { print $1; exit }')
    if [ -n "${output}" ]; then
      # Preferred mode first so a connected TV always gets a real signal, then
      # the configured mode on top if it is available.
      /usr/bin/xrandr --output "${output}" --auto --primary 2>/dev/null || true
      if [ -n "${mode}" ]; then
        /usr/bin/xrandr --output "${output}" --mode "${mode}" --rate "${rate}" 2>/dev/null || true
      fi
      geometry="$(/usr/bin/xrandr --query 2>/dev/null | grep -oE '[0-9]+x[0-9]+\+0\+0' | head -1)"
      size="${geometry%%+*}"
      if [ -n "${geometry}" ] && [ "${size}" != "1024x768" ]; then
        echo "Display configured: ${output} ${geometry}"
        return 0
      fi
    fi
    sleep 1
  done
  echo "Warning: could not configure a connected display after retries; leaving X at its default."
}
configure_display

configure_audio_output() {
  local output control
  if ! truthy_env "${MOTION_LEVELS_FORCE_ALSA_OUTPUT}"; then
    return 0
  fi

  output=$(/usr/bin/xrandr --query 2>/dev/null | awk '/ connected/ { print $1; exit }')
  if [ -n "${output}" ]; then
    /usr/bin/xrandr --output "${output}" --set audio on 2>/dev/null || true
  fi

  if command -v /usr/bin/amixer >/dev/null 2>&1; then
    for control in IEC958 "IEC958,0" "IEC958,1" "IEC958,2"; do
      /usr/bin/amixer -q sset "${control}" unmute 2>/dev/null || true
      /usr/bin/amixer -q sset "${control}" on 2>/dev/null || true
    done
  fi

  if command -v /usr/sbin/alsactl >/dev/null 2>&1; then
    /usr/sbin/alsactl store >/dev/null 2>&1 || true
  fi
}
configure_audio_output

# Capture the active screen geometry so Chromium can be forced to fill it. There
# is no window manager under this bare xinit session, so --kiosk alone keeps the
# Chromium window at its previously saved size; an explicit --window-size makes
# the player cover the whole TV even after the output resolution changes.
SCREEN_GEOMETRY="$(/usr/bin/xrandr --query 2>/dev/null | grep -oE '[0-9]+x[0-9]+\+0\+0' | head -1)"
SCREEN_SIZE="${SCREEN_GEOMETRY%%+*}"
SCREEN_WIDTH="${SCREEN_SIZE%x*}"
SCREEN_HEIGHT="${SCREEN_SIZE#*x}"

# 3. Ensure player user data directory exists
USER_DATA_DIR="${MOTION_LEVELS_PLAYER_PROFILE}"
mkdir -p "${USER_DATA_DIR}"

# 4. Hide mouse cursor if unclutter is available
if command -v /usr/bin/unclutter >/dev/null 2>&1; then
  /usr/bin/unclutter -idle 0.1 -root &
fi

# 5. Build Chromium arguments
CHROME_FLAGS=(
  --kiosk
  --no-first-run
  --new-window
  --user-data-dir="${USER_DATA_DIR}"
  --noerrdialogs
  --disable-infobars
  --disable-session-crashed-bubble
  --disable-translate
  --disable-features=Translate
  --window-position=0,0
  --window-size="${MOTION_LEVELS_PLAYER_WINDOW_SIZE}"
  --start-fullscreen
  --check-for-update-interval=31536000
  --autoplay-policy=no-user-gesture-required
)

# Force the window to cover the whole screen (no WM to maximise it for us).
if [ -n "${SCREEN_WIDTH:-}" ] && [ -n "${SCREEN_HEIGHT:-}" ]; then
  CHROME_FLAGS+=( --window-position=0,0 "--window-size=${SCREEN_WIDTH},${SCREEN_HEIGHT}" )
fi

# Chromium won't run as root without --no-sandbox
if [ "$(id -u)" -eq 0 ]; then
  CHROME_FLAGS+=( --no-sandbox )
fi

# Determine target URL
TARGET_URL="${MOTION_LEVELS_PLAYER_URL}"

echo "Starting Chromium kiosk pointing to ${TARGET_URL}..."
exec /usr/bin/chromium "${CHROME_FLAGS[@]}" --app="${TARGET_URL}"
