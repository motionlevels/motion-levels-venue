#!/bin/sh
set -eu

interval="${MOTION_LEVELS_HDMI_WATCHDOG_INTERVAL:-10}"
last_state=""

connector_state() {
  state="disconnected"
  for status in /sys/class/drm/card0-*/status; do
    [ -r "$status" ] || continue
    if [ "$(cat "$status")" = connected ]; then
      state="connected"
      break
    fi
  done
  printf '%s' "$state"
}

configure_hdmi_audio() {
  [ "${MOTION_LEVELS_FORCE_ALSA_OUTPUT:-0}" = "1" ] || return 0
  for control in IEC958 "IEC958,0" "IEC958,1" "IEC958,2"; do
    amixer -q sset "$control" unmute 2>/dev/null || true
    amixer -q sset "$control" on 2>/dev/null || true
  done
}

while :; do
  current="$(connector_state)"
  if [ "$current" != "$last_state" ]; then
    echo "HDMI connector state: $current"
    last_state="$current"
    [ "$current" = connected ] && configure_hdmi_audio
  fi
  sleep "$interval"
done
