#!/bin/sh
set -eu

if [ -n "${MOTION_LEVELS_PLATFORM_TOKEN_FILE:-}" ]; then
  MOTION_LEVELS_PLATFORM_TOKEN="$(cat "$MOTION_LEVELS_PLATFORM_TOKEN_FILE")"
  export MOTION_LEVELS_PLATFORM_TOKEN
fi
if [ -n "${MOTION_LEVELS_ENGINE_TOKEN_FILE:-}" ]; then
  MOTION_LEVELS_ENGINE_TOKEN="$(cat "$MOTION_LEVELS_ENGINE_TOKEN_FILE")"
  export MOTION_LEVELS_ENGINE_TOKEN
fi

node_binary=${MOTION_LEVELS_NODE_BINARY:-node}
runtime_entry=${MOTION_LEVELS_GAMES_RUNTIME_ENTRY:-}
if [ -z "$runtime_entry" ] && [ -f /app/games/venue/runtime.mjs ]; then
  runtime_entry=/app/games/venue/runtime.mjs
fi
if [ -z "$runtime_entry" ]; then
  games_root=${MOTION_LEVELS_GAMES_ROOT:-/opt/motion-levels/rebuild/current/game-bundles/motion-levels-games}
  runtime_entry="$("$node_binary" -e 'const fs=require("node:fs"); const path=require("node:path"); const root=process.argv[1]; const pin=JSON.parse(fs.readFileSync(path.join(root,"pin.json"))); process.stdout.write(path.join(root,pin.bundlePath,"venue/runtime.mjs"))' "$games_root")"
fi
exec "$node_binary" "$runtime_entry"
