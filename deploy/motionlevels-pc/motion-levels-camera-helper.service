[Unit]
Description=Motion Levels camera snapshot helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/motion-levels/motion-levels.env
EnvironmentFile=-/etc/motion-levels/camera.env
WorkingDirectory=/opt/motion-levels/rebuild/src/deploy/motionlevels-pc
ExecStart=/bin/sh -c 'if [ "${MOTION_LEVELS_CONTROLLER_HOSTNAME:-}" != "motionlevels-1" ]; then echo "camera helper disabled for ${MOTION_LEVELS_CONTROLLER_HOSTNAME:-unknown}"; exec sleep infinity; fi; if [ -z "${MOTION_LEVELS_CAMERA_PASSWORD:-}" ] && [ -z "${ML_TAPO_PASSWORD:-}" ]; then echo "camera helper waiting for camera password"; exec sleep infinity; fi; exec /usr/bin/python3 /opt/motion-levels/rebuild/src/deploy/motionlevels-pc/motion-levels-camera-helper.py'
Restart=always
RestartSec=2
Nice=12
CPUWeight=100
CPUQuota=45%
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
