[Unit]
Description=Motion Levels camera recording controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/motion-levels/motion-levels.env
EnvironmentFile=-/etc/motion-levels/platform.env
EnvironmentFile=-/etc/motion-levels/camera-recorder.env
WorkingDirectory=/opt/motion-levels/rebuild/src/deploy/motionlevels-pc
ExecStart=/usr/bin/python3 /opt/motion-levels/rebuild/src/deploy/motionlevels-pc/motion-levels-camera-recorder.py
Restart=always
RestartSec=2
Nice=10
CPUWeight=100
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
