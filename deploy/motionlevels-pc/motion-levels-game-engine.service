[Unit]
Description=Motion Levels TypeScript venue runtime
After=network-online.target motion-levels-floor-controller.service
Wants=network-online.target motion-levels-floor-controller.service

[Service]
Type=simple
WorkingDirectory=/opt/motion-levels/rebuild/current
EnvironmentFile=/etc/motion-levels/motion-levels.env
EnvironmentFile=-/etc/motion-levels/platform.env
Environment=MOTION_LEVELS_CONTROLLER_ADDR=127.0.0.1:4201
Environment=MOTION_LEVELS_GAMES_ROOT=/opt/motion-levels/rebuild/current/game-bundles/motion-levels-games
Environment=MOTION_LEVELS_NODE_BINARY=/opt/motion-levels/rebuild/current/bin/node
Environment=MOTION_LEVELS_CAMERA_RECORDER_TOKEN_FILE=/etc/motion-levels/camera-recorder-token
ExecStart=/opt/motion-levels/rebuild/current/deploy/motionlevels-pc/venue-game-engine
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
