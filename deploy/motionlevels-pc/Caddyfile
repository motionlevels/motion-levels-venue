:80 {
	encode zstd gzip

	handle_path /controller/* {
		reverse_proxy 127.0.0.1:4101
	}

	handle /controller {
		rewrite * /
		reverse_proxy 127.0.0.1:4101
	}

	handle /ws {
		reverse_proxy 127.0.0.1:4101
	}

	handle_path /engine/* {
		reverse_proxy 127.0.0.1:4102
	}

	# The /tv and /cameras pages — and the platform assets/APIs and camera
	# streams they depend on — are exposed only on the wired venue LAN address
	# (192.168.1.142), which lives solely on the ethernet interface. Each
	# handler ANDs the host with its path so other routes (/menu, /display,
	# /engine, ...) keep working on 192.168.1.142, while /tv and /cameras stay
	# unreachable from the wifi interface or any other address.
	@platform_tv {
		host 192.168.1.142
		path /tv /tv/
	}
	handle @platform_tv {
		rewrite * /salas/motionlevels-1/tv
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	@platform_cameras {
		host 192.168.1.142
		path /cameras /cameras/
	}
	handle @platform_cameras {
		root * /opt/motion-levels/rebuild/src/deploy/motionlevels-pc
		rewrite * /cameras.html
		header Cache-Control "no-store"
		file_server
	}

	# Camera frame endpoint. NOT restricted to the wired LAN address: the
	# platform pulls these snapshots over Tailscale (Host: motionlevels-1) for
	# its own cameras page, so gating this to 192.168.1.142 would break it.
	# Only the /cameras page above is ethernet-only.
	handle /cam/* {
		reverse_proxy 127.0.0.1:8020
	}

	handle /camera-recorder/* {
		respond "Legacy X5 recorder disabled; use motion-levels-cameras on port 8040" 410
	}

	@platform_next {
		host 192.168.1.142
		path /_next/*
	}
	handle @platform_next {
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	@platform_rooms {
		host 192.168.1.142
		path /api/rooms/*
	}
	handle @platform_rooms {
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	@platform_live_floor {
		host 192.168.1.142
		path /api/live-floor/*
	}
	handle @platform_live_floor {
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	handle /motion-levels-icon.png {
		root * /opt/motion-levels/rebuild/apps/player-menu/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /motion-levels-icon.webp {
		root * /opt/motion-levels/rebuild/apps/player-menu/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	redir /menu /menu/
	handle_path /menu/* {
		root * /opt/motion-levels/rebuild/apps/player-menu/dist
		@menu_assets path /assets/*
		header @menu_assets Cache-Control "public, max-age=31536000, immutable"
		@menu_index path / /index.html
		header @menu_index Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}

	redir /display /display/
	handle_path /display/* {
		root * /opt/motion-levels/rebuild/apps/player-display/dist
		@display_assets path /assets/*
		header @display_assets Cache-Control "public, max-age=31536000, immutable"
		@display_index path / /index.html
		header @display_index Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}

	redir /games /games/
	handle_path /games/* {
		root * /opt/motion-levels/rebuild/src/game-bundles/motion-levels-games
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /stack.json {
		root * /etc/motion-levels
		file_server
	}

	redir /status /engine/api/status
	redir / /menu/
}
