:80 {
	# Compress normal HTTP responses, but never SSE. Compressing the engine's
	# event streams buffers their small writes and forces kiosk clients onto
	# the low-frequency polling fallback.
	@compressible not path /engine/api/*/events
	encode @compressible zstd gzip

	handle /controller/health {
		rewrite * /health
		reverse_proxy 127.0.0.1:4101
	}

	handle /controller/metrics {
		rewrite * /metrics
		reverse_proxy 127.0.0.1:4101
	}

	handle /controller* {
		respond 404
	}

	handle_path /engine/* {
		reverse_proxy 127.0.0.1:4102
	}

	redir /venue /venue/
	handle_path /venue/* {
		root * {{ motion_levels_install_root }}/current/deploy/motionlevels-pc
		rewrite * /venue.html
		header Cache-Control "no-store"
		file_server
	}

	# Canonical host snapshot/control API. The supervisor itself is loopback
	# only; Caddy is the single network boundary shared by the local operator
	# page and the platform sala view over Tailscale.
	handle_path /venue-api/* {
		reverse_proxy 127.0.0.1:4103
	}

	# The native camera service stays loopback-only. This stable venue-owned
	# prefix is the single Tailscale/LAN boundary used by the local UI and the
	# platform sala view for preview, status, and authenticated controls.
	handle_path /camera-recorder/* {
		reverse_proxy 127.0.0.1:8040
	}

	# The /tv and /cameras pages — and the platform assets/APIs and camera
	# streams they depend on — are exposed only on the wired venue LAN address
	# ({{ motion_levels_network.lan.address | regex_replace('/.*$', '') }}), which lives solely on the ethernet interface. Each
	# handler ANDs the host with its path so other routes (/menu, /display,
	# /engine, ...) keep working on 192.168.1.142, while /tv and /cameras stay
	# unreachable from the wifi interface or any other address.
	@platform_tv {
		path /tv /tv/
		expression {http.request.local.host} == "{{ motion_levels_network.lan.address | regex_replace('/.*$', '') }}"
	}
	handle @platform_tv {
		rewrite * /salas/{{ motion_levels_venue.platform_room_slug }}/tv
		reverse_proxy {{ motion_levels_platform_origin }} {
			header_up Host {{ motion_levels_platform_host }}
			transport http {
				dial_timeout 10s
				tls_server_name {{ motion_levels_platform_host }}
			}
		}
	}

	@platform_cameras {
		path /cameras /cameras/
		expression {http.request.local.host} == "{{ motion_levels_network.lan.address | regex_replace('/.*$', '') }}"
	}
	handle @platform_cameras {
		root * {{ motion_levels_install_root }}/current/deploy/motionlevels-pc
		rewrite * /cameras.html
		header Cache-Control "no-store"
		file_server
	}

	# Camera frame endpoint. NOT restricted to the wired LAN address: the
	# platform pulls these snapshots over Tailscale for
	# its own cameras page, so gating this to 192.168.1.142 would break it.
	# Only the /cameras page above is ethernet-only.
	handle /cam/* {
		reverse_proxy 127.0.0.1:8020
	}

	@platform_next {
		path /_next/*
		expression {http.request.local.host} == "{{ motion_levels_network.lan.address | regex_replace('/.*$', '') }}"
	}
	handle @platform_next {
		reverse_proxy {{ motion_levels_platform_origin }} {
			header_up Host {{ motion_levels_platform_host }}
			transport http {
				dial_timeout 10s
				tls_server_name {{ motion_levels_platform_host }}
			}
		}
	}

	@platform_rooms {
		path /api/rooms/*
		expression {http.request.local.host} == "{{ motion_levels_network.lan.address | regex_replace('/.*$', '') }}"
	}
	handle @platform_rooms {
		reverse_proxy {{ motion_levels_platform_origin }} {
			header_up Host {{ motion_levels_platform_host }}
			transport http {
				dial_timeout 10s
				tls_server_name {{ motion_levels_platform_host }}
			}
		}
	}

	@platform_live_floor {
		path /api/live-floor/*
		expression {http.request.local.host} == "{{ motion_levels_network.lan.address | regex_replace('/.*$', '') }}"
	}
	handle @platform_live_floor {
		reverse_proxy {{ motion_levels_platform_origin }} {
			header_up Host {{ motion_levels_platform_host }}
			transport http {
				dial_timeout 10s
				tls_server_name {{ motion_levels_platform_host }}
			}
		}
	}

	handle /motion-levels-icon.png {
		root * {{ motion_levels_install_root }}/current/game-bundles/motion-levels-games/current/menu
		header Cache-Control "no-cache, max-age=0, must-revalidate"
		file_server
	}

	handle /motion-levels-icon.webp {
		root * {{ motion_levels_install_root }}/current/game-bundles/motion-levels-games/current/menu
		header Cache-Control "no-cache, max-age=0, must-revalidate"
		file_server
	}

	redir /menu /menu/
	handle_path /menu/* {
		root * {{ motion_levels_install_root }}/current/game-bundles/motion-levels-games/current/menu
		@menu_assets path /assets/*
		header @menu_assets Cache-Control "public, max-age=31536000, immutable"
		@menu_build path /build.json
		header @menu_build Cache-Control "no-store, max-age=0, must-revalidate"
		@menu_index path / /index.html
		header @menu_index Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}

	redir /display /display/
	handle_path /display/* {
		root * {{ motion_levels_install_root }}/current/game-bundles/motion-levels-games/current/display
		@display_assets path /assets/*
		header @display_assets Cache-Control "public, max-age=31536000, immutable"
		@display_index path / /index.html
		header @display_index Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}

	redir /games /games/
	handle_path /games/* {
		root * {{ motion_levels_install_root }}/current/game-bundles/motion-levels-games
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /stack.json {
		root * {{ motion_levels_state_root }}/public
		header Cache-Control "no-store"
		file_server
	}

	redir /status /engine/api/status
	redir / /menu/
}
