:80 {
	encode zstd gzip

	handle_path /controller/* {
		reverse_proxy 127.0.0.1:4101
	}

	handle /controller {
		rewrite * /
		reverse_proxy 127.0.0.1:4101
	}

	handle /ws {
		reverse_proxy 127.0.0.1:4101
	}

	handle_path /engine/* {
		reverse_proxy 127.0.0.1:4102
	}

	handle /cam/* {
		reverse_proxy 127.0.0.1:8020
	}

	@platform_tv path /tv /tv/
	handle @platform_tv {
		rewrite * /salas/motionlevels-1/tv
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	handle /_next/* {
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	handle /api/rooms/* {
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	handle /api/live-floor/* {
		reverse_proxy https://84.7.190.81 {
			header_up Host platform.motionlevels.obis.dev
			transport http {
				dial_timeout 10s
				tls_server_name platform.motionlevels.obis.dev
			}
		}
	}

	handle /motion-levels-icon.png {
		root * /opt/motion-levels/rebuild/apps/player-menu/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /motion-levels-icon.webp {
		root * /opt/motion-levels/rebuild/apps/player-menu/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	redir /menu /menu/
	handle_path /menu/* {
		root * /opt/motion-levels/rebuild/apps/player-menu/dist
		@menu_assets path /assets/*
		header @menu_assets Cache-Control "public, max-age=31536000, immutable"
		@menu_index path / /index.html
		header @menu_index Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}

	redir /display /display/
	handle_path /display/* {
		root * /opt/motion-levels/rebuild/apps/player-display/dist
		@display_assets path /assets/*
		header @display_assets Cache-Control "public, max-age=31536000, immutable"
		@display_index path / /index.html
		header @display_index Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}

	handle /stack.json {
		root * /etc/motion-levels
		file_server
	}

	redir /status /engine/api/status
	redir / /menu/
}
