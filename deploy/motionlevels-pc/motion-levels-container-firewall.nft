table inet motion_levels_venue
flush table inet motion_levels_venue
table netdev motion_levels_floor
flush table netdev motion_levels_floor

# Ipvlan L2 can deliver packets without traversing the ordinary inet forward
# hook. These device hooks enforce the floor boundary at the physical NIC.
table netdev motion_levels_floor {
  chain ingress {
    type filter hook ingress device "enp2s0" priority -10; policy accept;

    ip daddr 255.255.255.255 udp dport 7800 accept
    ip daddr 192.168.1.143 udp dport 7800 accept
    ip daddr 192.168.1.143 drop
  }

  chain egress {
    type filter hook egress device "enp2s0" priority -10; policy accept;

    ip saddr 192.168.1.143 ip daddr 255.255.255.255 udp dport 4626 accept
    ip saddr 192.168.1.143 drop
  }
}

table inet motion_levels_venue {
  chain input {
    type filter hook input priority -10; policy accept;

    ct state established,related accept

    # Containers have no general path back into host services. The dormant X5
    # integration is the one narrow, configuration-gated host upstream.
    ip saddr { 172.30.53.11, 172.30.53.12 } ip daddr 172.30.53.1 tcp dport 8040 accept
    ip saddr 172.30.50.0/24 reject with icmp type admin-prohibited
    ip saddr 172.30.51.0/24 reject with icmp type admin-prohibited
    ip saddr 172.30.52.0/24 reject with icmp type admin-prohibited
    ip saddr 172.30.53.0/24 reject with icmp type admin-prohibited
    ip saddr 172.30.54.0/24 reject with icmp type admin-prohibited

    # A host-wide input deny-list is intentionally deferred until after the
    # display/gameplay soak. This cutover limits the new container and hardware
    # interfaces without changing the appliance's management-plane policy.
  }

  chain forward {
    type filter hook forward priority -10; policy accept;

    ct state established,related accept

    # Docker may select either attached bridge address as the DNAT target for
    # Caddy. Only its two unprivileged listeners are published.
    ip daddr { 172.30.51.2, 172.30.52.13, 172.30.53.12, 172.30.54.2 } tcp dport { 8080, 8081 } accept

    # The floor's ipvlan L2 endpoint receives sensor traffic and can emit only
    # the limited LED broadcast. IPv4 pktinfo in the controller pins .143 and
    # enp2s0, including for link-local tiles that require 255.255.255.255.
    iifname "enp2s0" ip daddr 192.168.1.143 udp dport 7800 accept
    iifname "enp2s0" ip daddr 255.255.255.255 udp dport 7800 accept
    ip saddr 192.168.1.143 oifname "enp2s0" ip daddr 255.255.255.255 udp dport 4626 accept
    ip saddr 192.168.1.143 reject with icmp type admin-prohibited
    ip daddr 192.168.1.143 reject with icmp type admin-prohibited

    # Core and display are internal service meshes. Same-network traffic is
    # allowed, while accidental routing out of either network is rejected.
    ip saddr 172.30.52.0/24 ip daddr 172.30.52.0/24 accept
    ip saddr 172.30.52.0/24 reject with icmp type admin-prohibited
    ip daddr 172.30.52.0/24 reject with icmp type admin-prohibited
    ip saddr 172.30.51.0/24 ip daddr 172.30.51.0/24 accept
    ip saddr 172.30.51.0/24 reject with icmp type admin-prohibited
    ip daddr 172.30.51.0/24 reject with icmp type admin-prohibited

    # Camera snapshots cross a dedicated internal API bridge shared only by
    # the helper and Caddy; floor and engine are not attached to it.
    ip saddr 172.30.54.0/24 ip daddr 172.30.54.0/24 accept
    ip saddr 172.30.54.0/24 reject with icmp type admin-prohibited
    ip daddr 172.30.54.0/24 reject with icmp type admin-prohibited

    # Snapshot helper: RTSP only to the three fixed venue cameras.
    ip saddr 172.30.50.10 ip daddr { 192.168.1.128, 192.168.1.129, 192.168.1.130 } tcp dport 554 accept

    # Security recorder: its one RTSP source plus DNS, platform HTTPS, and the
    # fixed object-storage upload endpoint.
    ip saddr 172.30.50.11 ip daddr 192.168.1.130 tcp dport 554 accept
    ip saddr 172.30.50.11 ip daddr 192.168.1.1 udp dport 53 accept
    ip saddr 172.30.50.11 ip daddr 192.168.1.1 tcp dport 53 accept
    ip saddr 172.30.50.11 ip daddr 84.7.190.81 tcp dport 443 accept
    ip saddr 172.30.50.11 ip daddr 100.69.44.59 tcp dport 9000 accept
    ip saddr 172.30.50.0/24 reject with icmp type admin-prohibited
    ip daddr 172.30.50.0/24 reject with icmp type admin-prohibited

    # Core services use a separate egress bridge. Most DNS stays on the venue
    # router; the dual-homed floor uses explicit public resolvers so its queries
    # cannot select the hardware-only ipvlan route. Every process then receives
    # only the fixed external destinations needed for its role.
    ip saddr 172.30.53.0/24 ip daddr 192.168.1.1 udp dport 53 accept
    ip saddr 172.30.53.0/24 ip daddr 192.168.1.1 tcp dport 53 accept
    ip saddr 172.30.53.10 ip daddr { 1.0.0.1, 1.1.1.1 } udp dport 53 accept
    ip saddr 172.30.53.10 ip daddr { 1.0.0.1, 1.1.1.1 } tcp dport 53 accept
    ip saddr 172.30.53.10 ip daddr 84.7.190.81 tcp dport 443 accept
    ip saddr 172.30.53.11 ip daddr 84.7.190.81 tcp dport 443 accept
    ip saddr 172.30.53.11 ip daddr 100.69.44.59 tcp dport 9000 accept
    ip saddr 172.30.53.12 ip daddr 84.7.190.81 tcp dport 443 accept
    ip saddr 172.30.53.0/24 reject with icmp type admin-prohibited
    ip daddr 172.30.53.0/24 reject with icmp type admin-prohibited
  }

  chain output {
    type filter hook output priority -10; policy accept;

    # The retained native rollback controller is held to the same floor-output
    # interface as the containerized controller.
    oifname "enp2s0" ip daddr 255.255.255.255 udp dport 4626 accept
    ip daddr 255.255.255.255 udp dport 4626 reject with icmp type admin-prohibited
  }
}
