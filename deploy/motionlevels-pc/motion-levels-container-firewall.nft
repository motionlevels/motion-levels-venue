table inet motion_levels_venue
flush table inet motion_levels_venue

table inet motion_levels_venue {
  chain input {
    type filter hook input priority -10; policy accept;

    ip saddr 172.30.50.0/24 ct state established,related accept
    ip saddr 172.30.50.0/24 reject with icmp type admin-prohibited

    # The browser can reach only Caddy on its own bridge gateway.
    ip saddr 172.30.51.10 ct state established,related accept
    ip saddr 172.30.51.10 ip daddr 172.30.51.1 tcp dport 80 accept
    ip saddr 172.30.51.0/24 reject with icmp type admin-prohibited
  }

  chain forward {
    type filter hook forward priority -10; policy accept;

    # Permit replies from flows that these two containers were allowed to
    # originate, then keep their new egress deliberately narrow.
    ip saddr 172.30.50.0/24 ct state established,related accept

    # Snapshot helper: RTSP only to the three fixed venue cameras.
    ip saddr 172.30.50.10 ip daddr { 192.168.1.128, 192.168.1.129, 192.168.1.130 } tcp dport 554 accept

    # Security recorder: its one RTSP source plus HTTPS for the platform and
    # presigned object-storage uploads. Docker's embedded DNS forwards through
    # the host resolver while retaining the container source address.
    ip saddr 172.30.50.11 ip daddr 192.168.1.130 tcp dport 554 accept
    ip saddr 172.30.50.11 ip daddr 192.168.1.1 udp dport 53 accept
    ip saddr 172.30.50.11 ip daddr 192.168.1.1 tcp dport 53 accept
    ip saddr 172.30.50.11 ip daddr 84.7.190.81 tcp dport 443 accept
    ip saddr 172.30.50.11 ip daddr 100.69.44.59 tcp dport 9000 accept

    ip saddr 172.30.50.0/24 reject with icmp type admin-prohibited

    # No new routed egress is permitted from the display bridge.
    ip saddr 172.30.51.0/24 ct state established,related accept
    ip saddr 172.30.51.0/24 reject with icmp type admin-prohibited
  }
}
